        "command": "npx",
        "args": ["@salesforce/mcp", "--orgs", "YOUR_ORG_ALIAS", "--toolsets", "all"]
      },
      "omnistudio-mcp": {
        "command": "npx",
        "args": ["-y", "@salesforce/omnistudio-mcp"]
      },
      "b2c-dx-mcp": {
        "command": "npx",
        "args": ["-y", "@salesforce/b2c-dx-mcp", "--toolsets", "CARTRIDGES,MRT,SCAPI,PWAV3"]
      }
    }
  }
<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Brkg_Exist</name>
        <label>Brkg Exist</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>is_Brkg_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.BrokerageAmt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Renewal_Brokerage_Amt</targetReference>
            </connector>
            <label>is Brkg Exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Premium_Exist</name>
        <label>Premium Exist</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Brkg_Exist</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>is_Premium_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Total_Premium_Amount__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Renewal_Premium_Amount</targetReference>
            </connector>
            <label>is Premium Exist</label>
        </rules>
    </decisions>
    <description>ENDNo=0 &amp; Premium &lt;&gt; Null, or Brkg Amt &lt;&gt; Null 인 경우, Renewal 관리 금액 필드에 업데이트</description>
    <environments>Default</environments>
    <formulas>
        <description>보험료 &lt;&gt; Null, 수수료 = Null, 수수료율 &lt;&gt; Null 인 경우, 보험료 * 수수료율 을 계산</description>
        <name>fm_CalculateBrokerageAmount</name>
        <dataType>Number</dataType>
        <expression>IF ( NOT ( ISBLANK ( {!$Record.Total_Premium_Amount__c} ) ) &amp;&amp;
     ISBLANK ( {!$Record.BrokerageAmt__c} ) &amp;&amp;  
     NOT ( ISBLANK ( {!$Record.BrokerageRate__c} ) ), {!$Record.Total_Premium_Amount__c}  * {!$Record.BrokerageRate__c}, 0  )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fm_CalcurateBrokerageRate</name>
        <dataType>Number</dataType>
        <expression>IF ( NOT ( ISBLANK ( {!$Record.Total_Premium_Amount__c} ) ) &amp;&amp;
     NOT ( ISBLANK ( {!$Record.BrokerageAmt__c} ) ) &amp;&amp;  
     ISBLANK ( {!$Record.BrokerageRate__c} ), {!$Record.BrokerageAmt__c}  / {!$Record.Total_Premium_Amount__c}  , 0  )</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>LK_TRG_InsurancePolicy_AmountUpdate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LK_TRG_InsurancePolicy_AmountUpdate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Renewal_Brokerage_Amt</name>
        <label>Update Renewal Brokerage Amt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>RenewalBrokerageAmt__c</field>
            <value>
                <elementReference>$Record.BrokerageAmt__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Renewal_Premium_Amount</name>
        <label>Update Renewal Premium Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Brkg_Exist</targetReference>
        </connector>
        <inputAssignments>
            <field>RenewalPremium__c</field>
            <value>
                <elementReference>$Record.Total_Premium_Amount__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Premium_Exist</targetReference>
        </connector>
        <filterLogic>( 1 OR 2 ) AND 3</filterLogic>
        <filters>
            <field>Total_Premium_Amount__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>BrokerageAmt__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ENDNo__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <object>InsurancePolicy</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>v_SglRecInsurancePolicy</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>InsurancePolicy</objectType>
    </variables>
</Flow>

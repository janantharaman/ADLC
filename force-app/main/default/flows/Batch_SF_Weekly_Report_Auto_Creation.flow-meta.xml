    <formulas>
        <description>Flow 실행일의 요일을 취득</description>
        <name>fm_FindDay</name>
        <dataType>String</dataType>
        <expression>CASE(
  MOD( {!$Flow.CurrentDate} - DATE( 1900, 1, 7 ), 7 ),
  0, &quot;Sunday&quot;,
  1, &quot;Monday&quot;,
  2, &quot;Tuesday&quot;,
  3, &quot;Wednesday&quot;,
  4, &quot;Thursday&quot;,
  5, &quot;Friday&quot;, 
  &quot;Saturday&quot;
)</expression>
    </formulas>
    <formulas>
        <name>fm_NextWeekEnd</name>
        <dataType>Date</dataType>
        <expression>{!fm_WeekEnd} + 7</expression>
    </formulas>

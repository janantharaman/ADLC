        <name>fm_WeekEnd</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}</expression>
    </formulas>
    <formulas>
        <name>fm_WeekNo</name>
        <dataType>Number</dataType>
        <expression>ISOWEEK( {!fm_WeekStartCacl} )</expression>
        <scale>0</scale>

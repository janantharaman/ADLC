    <decisions>
        <name>Check_Retail_Record_Create</name>
        <label>Check Retail Record Create</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Retail_Bidding</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>var_RetailBiddingRecordTypeId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Retail_Opportunity_Info1</targetReference>
            </connector>
            <label>Retail-Bidding</label>
        </rules>
        <rules>
            <name>Retail_Non_Bidding</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>var_RetailPrivateRecordTypeId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Retail_Opportunity_Info2</targetReference>
            </connector>
            <label>Retail-Non Bidding</label>
        </rules>
        <rules>
            <name>Reinsurance</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>v_ReinsuranceRecordTypeId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Reinsurance_Opportunity_Info</targetReference>
            </connector>
            <label>Reinsurance</label>
        </rules>
    </decisions>
    <description>Oppty 생성 시, Opportunity Name Setting
(Close Date)YYMM_Insured_LOB3_식별값</description>
    <environments>Default</environments>
    <formulas>
        <name>fm_BizRegion</name>
        <dataType>String</dataType>
        <expression>CASE( {!$Record.Owner.Region__c},
&quot;KR&quot;, &quot;LK_KR&quot;,
&quot;SG&quot;, &quot;LK_Re&quot;,
&quot;VN&quot;, &quot;LK_VN&quot;,
&quot;A&amp;G&quot;, &quot;LK_A&amp;G&quot;,
&quot;None&quot;
)</expression>
    </formulas>
    <formulas>
        <name>fm_ExpirationDate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Record.CRSInceptionDatedt__c},12)</expression>
    </formulas>
    <formulas>
        <name>fm_ExpirationDate2</name>
        <dataType>DateTime</dataType>
        <expression>CASE( {!fm_BizRegion},
&quot;LK_KR&quot;, DATETIMEVALUE( TEXT ( {!fm_ExpirationDate} ) &amp; &quot; 00:00:00&quot; ) - (9/24),
&quot;LK_Re&quot;, DATETIMEVALUE( TEXT ( {!fm_ExpirationDate} ) &amp; &quot; 00:00:00&quot; ) - (8/24),
&quot;LK_VN&quot;, DATETIMEVALUE( TEXT ( {!fm_ExpirationDate} ) &amp; &quot; 00:00:00&quot; ) - (7/24),
&quot;LK_A&amp;G&quot;, DATETIMEVALUE( TEXT ( {!fm_ExpirationDate} ) &amp; &quot; 00:00:00&quot; ) - (9/24),
null
)</expression>
    </formulas>
    <formulas>
        <name>fm_InceptionDate</name>
        <dataType>DateTime</dataType>
        <expression>CASE( {!fm_BizRegion},
&quot;LK_KR&quot;, DATETIMEVALUE ( TEXT ( {!$Record.CRSInceptionDatedt__c} ) &amp; &quot; 00:00:00&quot; ) - (9/24),
&quot;LK_Re&quot;, DATETIMEVALUE ( TEXT ( {!$Record.CRSInceptionDatedt__c} ) &amp; &quot; 00:00:00&quot; ) - (8/24),
&quot;LK_VN&quot;, DATETIMEVALUE ( TEXT ( {!$Record.CRSInceptionDatedt__c} ) &amp; &quot; 00:00:00&quot; ) - (7/24),
&quot;LK_A&amp;G&quot;, DATETIMEVALUE ( TEXT ( {!$Record.CRSInceptionDatedt__c} ) &amp; &quot; 00:00:00&quot; ) - (9/24),
null
)</expression>
    </formulas>
    <formulas>
        <name>fm_NameMonth</name>
        <dataType>String</dataType>
        <expression>IF ( {!$Record.RecordType.Id} = {!v_ReinsuranceRecordTypeId},
  IF ( TEXT ( MONTH ( {!$Record.PeriodFrom__c} ) ) = &quot;10&quot; || 
        TEXT ( MONTH ( {!$Record.PeriodFrom__c} ) ) = &quot;11&quot; || 
        TEXT ( MONTH ( {!$Record.PeriodFrom__c} ) ) = &quot;12&quot;,  TEXT ( MONTH ( {!$Record.PeriodFrom__c} ) ) , 
        &quot;0&quot; &amp; TEXT ( MONTH ( {!$Record.PeriodFrom__c} ) )
  ),
  IF ( TEXT ( MONTH ( {!$Record.CRSInceptionDatedt__c} ) ) = &quot;10&quot; || 
        TEXT ( MONTH ( {!$Record.CRSInceptionDatedt__c} ) ) = &quot;11&quot; || 
        TEXT ( MONTH ( {!$Record.CRSInceptionDatedt__c} ) ) = &quot;12&quot;,  TEXT ( MONTH ( {!$Record.CRSInceptionDatedt__c} ) ) , 
        &quot;0&quot; &amp; TEXT ( MONTH ( {!$Record.CRSInceptionDatedt__c} ) )
  )
)</expression>
    </formulas>
    <formulas>
        <name>fm_NameYear</name>
        <dataType>String</dataType>
        <expression>IF ( {!$Record.RecordType.Id} = {!v_ReinsuranceRecordTypeId},
    RIGHT ( TEXT ( YEAR ( {!$Record.PeriodFrom__c} ) ), 2 ),
    RIGHT ( TEXT ( YEAR ( {!$Record.CRSInceptionDatedt__c} ) ), 2 )
)</expression>
    </formulas>
    <formulas>
        <name>fm_OpportunityName</name>
        <dataType>String</dataType>
        <expression>IF ( ISBLANK( {!$Record.CRSIdentificationValue__c} ) , {!fm_NameYear} &amp; {!fm_NameMonth} &amp;&quot;_&quot;&amp;
{!$Record.CRSInsured_lk__r.Name} &amp;&quot;_&quot;&amp;
TEXT ( {!$Record.LOB3__c} ), 
{!fm_NameYear} &amp; {!fm_NameMonth} &amp;&quot;_&quot;&amp;
{!$Record.CRSInsured_lk__r.Name} &amp;&quot;_&quot;&amp;
TEXT ( {!$Record.LOB3__c} ) &amp;&quot;_&quot;&amp;
{!$Record.CRSIdentificationValue__c}
)</expression>
    </formulas>
    <formulas>
        <name>fm_ReinsOpportunityName</name>
        <dataType>String</dataType>
        <expression>IF(
    TEXT({!$Record.BizRegion__c}) = &quot;LK_Re&quot;,
    /* BizRegion이 SG일 때 */
    IF(
        {!$Record.RecordTypeId} = {!v_ReinsuranceRecordTypeId},
        LEFT({!fm_NameYear} &amp; {!fm_NameMonth} &amp; &quot;_&quot; &amp; {!$Record.CedantName_lk__r.CompanyAcronym__c} &amp; &quot;_&quot; &amp; &quot;_&quot;&amp;{!$Record.LKInsured__c}, 80),
        NULL
    ),
    /* 그 외 지역일 때 (Else) */
    LEFT({!fm_NameYear} &amp; {!fm_NameMonth} &amp; &quot;_&quot; &amp; {!$Record.CedantName_lk__r.CompanyAcronym__c} &amp; &quot;_&quot; &amp; {!$Record.LKInsured__c} &amp;&quot;_&quot; &amp; TEXT({!$Record.CedingType1__c}), 80)
)</expression>
    </formulas>
    <formulas>
        <name>fm_UYYear</name>
        <dataType>String</dataType>
        <expression>TEXT ( YEAR ( {!$Record.PeriodFrom__c} ) )</expression>
    </formulas>

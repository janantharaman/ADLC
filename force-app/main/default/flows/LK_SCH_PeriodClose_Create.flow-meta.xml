    <description>매년 1 월 1 일에 현재부터 2년 후 월마감(Period Close) 데이타 확인 후 없으면 1년치 레코드 생성</description>
    <environments>Default</environments>
    <formulas>
        <name>fm_Add2Year</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!fm_Today}) + 2 , 1 , 1)</expression>
    </formulas>
    <formulas>
        <name>fm_EndDate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS( {!fm_StartDate} , 1) - 1</expression>
    </formulas>
    <formulas>
        <name>fm_EntryDeadline</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS( {!fm_StartDate} , 1 ) + 2</expression>
    </formulas>
    <formulas>
        <name>fm_FirstDay</name>
        <dataType>Number</dataType>
        <expression>DAY({!fm_Today})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fm_FirstMonth</name>
        <dataType>Number</dataType>
        <expression>MONTH({!fm_Today})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fm_NameAG</name>
        <dataType>String</dataType>
        <expression>&quot;[LK_A&amp;G] &quot; &amp; TEXT(YEAR( {!fm_StartDate} )) &amp; &quot;-&quot; &amp; RIGHT(TEXT(MONTH( {!fm_StartDate} ) + 100) ,2)</expression>
    </formulas>
    <formulas>
        <name>fm_NameKR</name>
        <dataType>String</dataType>
        <expression>&quot;[LK_KR] &quot; &amp; TEXT(YEAR( {!fm_StartDate} )) &amp; &quot;-&quot; &amp; RIGHT(TEXT(MONTH( {!fm_StartDate} ) + 100) ,2)</expression>
    </formulas>
    <formulas>
        <name>fm_NameRe</name>
        <dataType>String</dataType>
        <expression>&quot;[LK_Re] &quot; &amp; TEXT(YEAR( {!fm_StartDate} )) &amp; &quot;-&quot; &amp; RIGHT(TEXT(MONTH( {!fm_StartDate} ) + 100) ,2)</expression>
    </formulas>
    <formulas>
        <name>fm_NameVN</name>
        <dataType>String</dataType>
        <expression>&quot;[LK_VN] &quot; &amp; TEXT(YEAR( {!fm_StartDate} )) &amp; &quot;-&quot; &amp; RIGHT(TEXT(MONTH( {!fm_StartDate} ) + 100) ,2)</expression>
    </formulas>
    <formulas>
        <name>fm_StartDate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS( {!fm_Add2Year} , {!v_MCount} )</expression>
    </formulas>
    <formulas>
        <name>fm_Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>

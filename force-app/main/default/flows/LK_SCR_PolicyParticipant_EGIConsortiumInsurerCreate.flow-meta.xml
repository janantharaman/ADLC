    <formulas>
        <name>fm_InceptionDateMonth</name>
        <dataType>String</dataType>
        <expression>IF ( TEXT ( MONTH ( DATEVALUE ( {!Inception_Date_C} ) ) ) = &quot;10&quot; || 
      TEXT ( MONTH ( DATEVALUE (  {!Inception_Date_C} ) ) ) = &quot;11&quot; || 
      TEXT ( MONTH ( DATEVALUE (  {!Inception_Date_C} ) ) ) = &quot;12&quot;, 
TEXT ( MONTH ( DATEVALUE (  {!Inception_Date_C} ) ) ) ,
&quot;0&quot; &amp; TEXT ( MONTH ( DATEVALUE (  {!Inception_Date_C} ) ) )
)</expression>
    </formulas>
    <formulas>
        <name>fm_InceptionDateYear2Char</name>
        <dataType>String</dataType>
        <expression>RIGHT ( TEXT ( YEAR ( DATEVALUE ( {!Inception_Date_C} ) ) ), 2 )</expression>
    </formulas>
    <formulas>
        <name>fm_InceptionDateYear4Char</name>
        <dataType>String</dataType>
        <expression>TEXT ( YEAR ( DATEVALUE ( {!Inception_Date_C} ) ) )</expression>
    </formulas>
    <formulas>
        <name>fm_PolicyName</name>
        <dataType>String</dataType>
        <expression>IF ( ISNULL ( {!Identification_Value} ), {!fm_InceptionDateYear2Char} &amp; {!fm_InceptionDateMonth} &amp; &quot;_&quot; &amp; {!Get_Master_Policy_Info.PolicyHodler_lk__r.Name} &amp; &quot;_&quot; &amp; TEXT ( {!Get_Master_Policy_Info.LOB3__c} ), 
{!fm_InceptionDateYear2Char} &amp; {!fm_InceptionDateMonth} &amp; &quot;_&quot; &amp; {!Get_Master_Policy_Info.PolicyHodler_lk__r.Name} &amp; &quot;_&quot; &amp; TEXT ( {!Get_Master_Policy_Info.LOB3__c} ) &amp; &quot;_&quot; &amp;  {!Identification_Value}
)</expression>
    </formulas>
    <formulas>
        <name>fm_PolicyPeriodMonth</name>
        <dataType>Number</dataType>
        <expression>DATEVALUE ( {!Get_Master_Policy_Info.ExpirationDate} ) - DATEVALUE ( {!Get_Master_Policy_Info.InceptionDate__c} )</expression>
        <scale>0</scale>
    </formulas>

    <decisions>
        <description>Case1. PM으로 지정된 Member 가 이미 Project Manager 역할로 등록되어 있는 경우
Case2. PM으로 지정된 Member 가 Project Manager 역할 외로 등록되어 있는 경우
Case3. PM으로 지정된 Member 가 신규 Member 인 경우</description>
        <name>Check_Exist_Member</name>
        <label>Check Exist Member</label>
        <locationX>666</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Check_Default_PM_Exist</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>is_Exist_Project_Manager</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Member_New_PM_Info</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_ExistMemberRole</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Project Manager</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_New_PM_default_PM_true</targetReference>
            </connector>
            <label>is Exist &amp; Project Manager</label>
        </rules>
        <rules>
            <name>is_Exist_Non_Project_Manager</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Member_New_PM_Info</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_ExistMemberRole</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Project Manager</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_New_PM_Role_default_PM_true</targetReference>
            </connector>
            <label>is Exist &amp; Non Project Manager</label>
        </rules>
        <rules>
            <name>is_New_Member</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Member_New_PM_Info</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Email_in_Project_Member</targetReference>
            </connector>
            <label>is New Member</label>
        </rules>
    </decisions>

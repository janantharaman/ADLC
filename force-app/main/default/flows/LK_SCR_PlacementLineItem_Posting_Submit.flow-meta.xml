    <formulas>
        <name>fm_ApprovalName</name>
        <dataType>String</dataType>
        <expression>LEFT( &quot;[ReInsurance Posting] &quot; &amp; {!get_Placement.Name} , 80 )</expression>
    </formulas>
    <formulas>
        <name>fm_Area</name>
        <dataType>String</dataType>
        <expression>CASE({!var_Region} 
 ,&quot;LK_KR&quot;,&quot;KR&quot;
 ,&quot;LK_Re&quot;,&quot;SG&quot;
 ,&quot;LK_VN&quot;,&quot;VN&quot;
 , &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fm_P_LItemStatus</name>
        <dataType>String</dataType>
        <expression>CASE({!Loop_P_LItem.Status__c}
 , &quot;Posting Open&quot; , &quot;Posting Submit&quot;
 , &quot;Posting Rejected&quot; , &quot;Posting Submit&quot;
 , &quot;Adjustment Open&quot; , &quot;Adjustment Submit&quot;
 , &quot;Adjustment Rejected&quot; , &quot;Adjustment Submit&quot;
 , &quot;Reverse Open&quot; , &quot;Reverse Submit&quot;
 , &quot;Reverse Rejected&quot; , &quot;Reverse Submit&quot;
 , &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fm_Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>

<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Count</name>
        <label>Add Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_MonthADdCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Month_Check</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Accounting_Date_Next_Open</name>
        <label>Set Accounting Date(Next Open)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>OUT_AccountingDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fm_AccountingDate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Accounting_Date_Open</name>
        <label>Set Accounting Date(Open)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>OUT_AccountingDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>IN_InceptionDate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Posting_Date</name>
        <label>Set Posting Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>OUT_PostingDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fm_Today</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Period_Close_Status</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Add_Month_Check</name>
        <label>Add Month Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Over 10</defaultConnectorLabel>
        <rules>
            <name>Under_10</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_MonthADdCount</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>36.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Next_Period_Close</targetReference>
            </connector>
            <label>Under 10</label>
        </rules>
    </decisions>
    <decisions>
        <name>Next_Month_Period_Close_Status</name>
        <label>Next Month Period Close Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Add_Count</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Open_Next_Month</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Next_Period_Close.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Next_Period_Close.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Re Open</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Accounting_Date_Next_Open</targetReference>
            </connector>
            <label>Open (Next Month)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Period_Close_Status</name>
        <label>Period Close Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Exit</defaultConnectorLabel>
        <rules>
            <name>Open</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>get_Period_Close.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>get_Period_Close.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Re Open</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Accounting_Date_Open</targetReference>
            </connector>
            <label>Open</label>
        </rules>
        <rules>
            <name>Closeed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_Period_Close.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Count</targetReference>
            </connector>
            <label>Closeed</label>
        </rules>
    </decisions>
    <description>법인정보(Org) 및 개시일(Inception Date)을 입력 받아 Posting Date 및 Accounting Date 산정</description>
    <environments>Default</environments>
    <formulas>
        <name>fm_AccountingDate</name>
        <dataType>Date</dataType>
        <expression>IF(TEXT(YEAR({!fm_Today})) &amp; TEXT(MONTH({!fm_Today}))  &lt;= TEXT(YEAR({!Next_Period_Close.StartDate__c})) &amp; TEXT(MONTH({!Next_Period_Close.StartDate__c})) , {!fm_Today} , ADDMONTHS(DATE(YEAR({!Next_Period_Close.StartDate__c}),MONTH({!Next_Period_Close.StartDate__c}),1) ,1 ) -1 )</expression>
    </formulas>
    <formulas>
        <name>fm_InceptionDateAddMonth</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!IN_InceptionDate},{!var_MonthADdCount})</expression>
    </formulas>
    <formulas>
        <name>fm_Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>LK_AUT_CALC_AccountingDate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LK_AUT_CALC_AccountingDate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>get_Period_Close</name>
        <label>get Period Close</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Posting_Date</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StartDate__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>IN_InceptionDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>EndDate__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>IN_InceptionDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>BizRegion__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>IN_Region</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PeriodClose__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Next_Period_Close</name>
        <label>Next Period Close</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Next_Month_Period_Close_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StartDate__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>fm_InceptionDateAddMonth</elementReference>
            </value>
        </filters>
        <filters>
            <field>EndDate__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>fm_InceptionDateAddMonth</elementReference>
            </value>
        </filters>
        <filters>
            <field>BizRegion__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>IN_Region</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PeriodClose__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>get_Period_Close</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>IN_InceptionDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>IN_Region</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>OUT_AccountingDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>OUT_PostingDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>var_MonthADdCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>

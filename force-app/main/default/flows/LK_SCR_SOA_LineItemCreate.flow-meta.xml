        <name>fm_CurrentUniqueKey</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Loop_SLI_for_Unique_Key.RefReinsurance__c})), 
    {!Loop_SLI_for_Unique_Key.RefReinsurance__c} &amp; &quot;_&quot; &amp; TEXT({!Loop_SLI_for_Unique_Key.OriginCurrency__c}),
    IF(NOT(ISBLANK({!Loop_SLI_for_Unique_Key.RefClaim__c})), 
        {!Loop_SLI_for_Unique_Key.RefClaim__c} &amp; &quot;_&quot; &amp; TEXT({!Loop_SLI_for_Unique_Key.OriginCurrency__c}), 
        &quot;&quot;
    )
)</expression>
    </formulas>

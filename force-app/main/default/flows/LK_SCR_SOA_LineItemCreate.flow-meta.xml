    <decisions>
        <description>BDX Type이 Debit Note 인지, SOA 인지 확인
1. Debit Note 이면 Cedant
2. SOA이면 Reinsurer</description>
        <name>Debit_or_SOA</name>
        <label>Debit or SOA?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Debit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_SOA.BDXType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Debit Note</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Settlement_Line_Item_Debit</targetReference>
            </connector>
            <label>Debit</label>
        </rules>
        <rules>
            <name>SOA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_SOA.BDXType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SOA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Settlement_Line_Item_SOA</targetReference>
            </connector>
            <label>SOA</label>
        </rules>
    </decisions>

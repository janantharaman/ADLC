<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Retail_Record_Create</name>
        <label>Check Retail Record Create</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Retail_Bidding</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>var_RetailBiddingRecordTypeId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Retail_Opportunity_Info1</targetReference>
            </connector>
            <label>Retail-Bidding</label>
        </rules>
        <rules>
            <name>Retail_Non_Bidding</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>var_RetailPrivateRecordTypeId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Retail_Opportunity_Info2</targetReference>
            </connector>
            <label>Retail-Non Bidding</label>
        </rules>
    </decisions>
    <description>[Before]Retail 영업기회 생성 시, Opportunity Name 설정</description>
    <environments>Default</environments>
    <formulas>
        <name>fm_NameMonth</name>
        <dataType>String</dataType>
        <expression>IF ( TEXT ( MONTH ( {!$Record.CloseDate} ) ) = &quot;10&quot; || 
      TEXT ( MONTH ( {!$Record.CloseDate} ) ) = &quot;11&quot; || 
      TEXT ( MONTH ( {!$Record.CloseDate} ) ) = &quot;12&quot;, 
TEXT ( MONTH ( {!$Record.CloseDate} ) ) ,
&quot;0&quot; &amp; TEXT ( MONTH ( {!$Record.CloseDate} ) )
)</expression>
    </formulas>
    <formulas>
        <name>fm_NameYEar</name>
        <dataType>String</dataType>
        <expression>RIGHT ( TEXT ( YEAR ( {!$Record.CloseDate} ) ), 2 )</expression>
    </formulas>
    <formulas>
        <name>fm_OpportunityName</name>
        <dataType>String</dataType>
        <expression>{!fm_NameYEar} &amp; {!fm_NameMonth} &amp;&quot;_&quot;&amp;
{!$Record.CRSPolicyholder_lk__r.Name} &amp;&quot;_&quot;&amp;
TEXT ( {!$Record.LOB3__c} ) &amp;&quot;_&quot;&amp;
{!$Record.CRSIdentificationValue__c}</expression>
    </formulas>
    <interviewLabel>LK_TRG_Opportunity_OpportunityNameSetting {!$Flow.CurrentDateTime}</interviewLabel>
    <label>(X)LK_TRG_Opportunity_OpportunityNameSetting</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Retail(Private/Renewal) Record Type Id 취득</description>
        <name>Get_RecordTypeId</name>
        <label>Get RecordTypeId1</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_RecordTypeId2</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Retail(Private/Renewal)</stringValue>
            </value>
        </filters>
        <object>RecordType</object>
        <outputAssignments>
            <assignToReference>var_RetailPrivateRecordTypeId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <description>Retail(Bidding) Record Type ID 취득</description>
        <name>Get_RecordTypeId2</name>
        <label>Get RecordTypeId2</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Retail_Record_Create</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Retail(Bidding)</stringValue>
            </value>
        </filters>
        <object>RecordType</object>
        <outputAssignments>
            <assignToReference>var_RetailBiddingRecordTypeId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>Update_Retail_Opportunity_Info1</name>
        <label>Update Retail Opportunity Info1</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>$Record.CRSPolicyholder_lk__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>fm_OpportunityName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>New(Bidding)</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Retail_Opportunity_Info2</name>
        <label>Update Retail Opportunity Info2</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>$Record.CRSPolicyholder_lk__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>fm_OpportunityName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>New(Private)</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_RecordTypeId</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>

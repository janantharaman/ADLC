    <description>SOA 생성</description>
    <dynamicChoiceSets>
        <description>- Claim: SOC/PLA Received Date 기준, From~to 기간에 속해 있는 건</description>
        <name>Choice_Claim</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ReceivedDate__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>From</elementReference>
            </value>
        </filters>
        <filters>
            <field>ReceivedDate__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>To</elementReference>
            </value>
        </filters>
        <object>Claim</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <description>- Placement: 보험 개시일 기준, From~to 기간에 속해있는 건
- Placement (배서) : Endt Effective Date 기준, From~to 기간에 속해 있는 건</description>
        <name>Choice_Placement</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>(1 AND 2) OR (3 AND 4)</filterLogic>
        <filters>
            <field>InceptionDate__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>From</elementReference>
            </value>
        </filters>
        <filters>
            <field>ExpirationDate__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>To</elementReference>
            </value>
        </filters>
        <filters>
            <field>ENDEffectivedDate__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>From</elementReference>
            </value>
        </filters>
        <filters>
            <field>ENDEffectivedDate__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>To</elementReference>
            </value>
        </filters>
        <object>Placement__c</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>

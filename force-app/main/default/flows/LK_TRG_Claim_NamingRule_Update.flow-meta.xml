        <name>fm_ParentName_New</name>
        <dataType>String</dataType>
        <expression>IF(  ISBLANK($Record.Placement_lk__r.Name),
  &quot;None-CLM-001&quot;,
  {!$Record.Placement_lk__r.LKRefNoh__c} &amp; &quot;-CLM-&quot; &amp; RIGHT(&quot;000&quot; &amp; TEXT({!var_PlacementParentCount}), 3)
)</expression>
    </formulas>
    <formulas>

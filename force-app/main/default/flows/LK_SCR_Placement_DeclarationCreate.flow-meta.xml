    <description>1. Declaration 을 실행한 Placement 정보 조회
2. Declaration 을 실행한 Placement 정보와 연결된 Premium Schedule 정보 조회
3. Declaration 실행 화면 Action (Currency 별 Gross Prem (100%) 입력)
4. Declaration Placement 생성
5. Declaration Premium Schedule 생성
6. Declaration Co Broker 생성
7. Declaration Layer 생성
8. Declaration Panel 생성
9. Declaration Subjectivity 생성</description>
    <environments>Default</environments>
    <formulas>
        <name>fm_ParentPlacementId</name>
        <dataType>String</dataType>
        <expression>IF ( ISBLANK ( {!Get_Placement.ParentPlacement__c} ), {!recordId}, {!Get_Placement.ParentPlacement__c} )</expression>
    </formulas>
    <formulas>
        <name>fm_TransactionSeq</name>
        <dataType>Number</dataType>
        <expression>{!Get_Placement.TransactionSeq__c} + 1</expression>
        <scale>0</scale>
    </formulas>

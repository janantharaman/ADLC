<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Get_Result</name>
        <label>Check Get Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>normal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>v_PolicyInsuredId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Original_Insured</targetReference>
            </connector>
            <label>normal</label>
        </rules>
    </decisions>
    <description>Placement 에 관련된 원보험 계약이 지정된 경우, 해당 계약의 Insured 를 Placement 에 지정</description>
    <environments>Default</environments>
    <interviewLabel>LK_TRG_Placement_RefPolicyUpdate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LK_TRG_Placement_RefPolicyUpdate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Insurer_from_Insurance_Policy</name>
        <label>Get Insurer from Insurance Policy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Get_Result</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.RefInsurancePolicy_lk__c</elementReference>
            </value>
        </filters>
        <object>InsurancePolicy</object>
        <outputAssignments>
            <assignToReference>v_PolicyInsuredId</assignToReference>
            <field>NameInsuredId</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>Update_Original_Insured</name>
        <label>Update Original Insured</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>OriginalInsured_lk__c</field>
            <value>
                <elementReference>v_PolicyInsuredId</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Insurer_from_Insurance_Policy</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RefInsurancePolicy_lk__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>RefInsurancePolicy_lk__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Placement__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>v_PolicyInsuredId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>

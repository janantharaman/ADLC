<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Search 용 필드 값 업데이트</description>
    <environments>Default</environments>
    <formulas>
        <name>fm_Name</name>
        <dataType>String</dataType>
        <expression>LEFT(
    {!$Record.Facility_lk__r.Name} &amp; &quot;_&quot; &amp; 
    IF(
        {!$Record.Cedant__c}=NULL, 
        {!$Record.ReinsurerAccount_lk__r.CompanyAcronym__c}, 
        {!$Record.CedantAccount_lk__r.CompanyAcronym__c}
    ),
    80
)</expression>
    </formulas>
    <interviewLabel>LK_TRG_FacilityParticipant_SearchName_Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LK_TRG_FacilityParticipant_SearchName_Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Company_Name</name>
        <label>Update Company Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Cedant__c</field>
            <value>
                <elementReference>$Record.CedantAccount_lk__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Facility__c</field>
            <value>
                <elementReference>$Record.Facility_lk__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>fm_Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Reinsurer__c</field>
            <value>
                <elementReference>$Record.ReinsurerAccount_lk__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Company_Name</targetReference>
        </connector>
        <object>COM_FacilityParticipant__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>

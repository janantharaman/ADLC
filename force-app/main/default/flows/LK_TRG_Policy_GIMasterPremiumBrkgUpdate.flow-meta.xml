<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Master_Update_Premium_And_Brkg_Amt</name>
        <label>Add Master Update Premium And Brkg Amt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>v_OtherChildPolicyBrkgAmt</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fm_TriggerBrkgAmt</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>v_OtherChilePolicyPremium</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>fm_TriggerPremium</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Master_Policy_Premium_and_Brkg_Amt</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Premium_and_Brkg_Amt</name>
        <label>Add Premium and Brkg Amt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>v_OtherChilePolicyPremium</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Filter_Other_Child_Policy.Total_Premium_Amount__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>v_OtherChildPolicyBrkgAmt</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Filter_Other_Child_Policy.BrokerageAmt__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Filter_Other_Child_Policy</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_Other_Child_Policy</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Other Child Policy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Other_Child_Policy</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Child_Policy_Info</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Other_Child_Policy.Id</leftValueReference>
            <operator>NotEqualTo</operator>
            <rightValue>
                <elementReference>fm_TriggerCurrentChildPolicyId</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Check_Filter_Result</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Check_Filter_Result</name>
        <label>Check Filter Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_Master_Update_Premium_And_Brkg_Amt</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Other_Child_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Filter_Other_Child_Policy</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Filter_Other_Child_Policy</targetReference>
            </connector>
            <label>Other Child Exist</label>
        </rules>
    </decisions>
    <description>단체보험 Child Policy 의 Premium, Brkg Amt 가 변경된 경우, 관련 Master Policy 의 Premium, Brkg Amt 에 롤업</description>
    <environments>Default</environments>
    <formulas>
        <name>fm_BrkgRate</name>
        <dataType>Number</dataType>
        <expression>( {!v_OtherChildPolicyBrkgAmt} / {!v_OtherChilePolicyPremium} ) * 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fm_TriggerBrkgAmt</name>
        <dataType>Number</dataType>
        <expression>{!$Record.BrokerageAmt__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fm_TriggerCurrentChildPolicyId</name>
        <dataType>String</dataType>
        <expression>{!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>fm_TriggerMasterPolicyId</name>
        <dataType>String</dataType>
        <expression>{!$Record.EGIMasterPolicy_lk__c}</expression>
    </formulas>
    <formulas>
        <name>fm_TriggerPremium</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Total_Premium_Amount__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>LK_TRG_Policy_GIMasterPremiumBrkgUpdate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LK_TRG_Policy_GIMasterPremiumBrkgUpdate</label>
    <loops>
        <name>Loop_Filter_Other_Child_Policy</name>

<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Participant 생성 시, 관련 보험사/보종에 해당하는 약정 수수율을 취득하여 갱신</description>
    <environments>Default</environments>
    <interviewLabel>LK_TRG_PolicyParticipant_InsurerCommissionUpdate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LK_TRG_PolicyParticipant_InsurerCommissionUpdate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Participant 생성하는 Insurer 및 보종에 해당하는 약정 수수료율 을 취득</description>
        <name>Get_Insurer_Commission</name>
        <label>Get Insurer Commission</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Insurer_Commission_Rate</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Insurer_lk__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Insurer__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>LOB1__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.InsurancePolicy.LOB1__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>LOB2__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.InsurancePolicy.LOB2__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>LOB3__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.InsurancePolicy.LOB3__c</elementReference>
            </value>
        </filters>
        <object>COM_InsurerCommission__c</object>
        <outputAssignments>
            <assignToReference>var_InsurerCommission</assignToReference>
            <field>InsurerCommission__c</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>Update_Insurer_Commission_Rate</name>
        <label>Update Insurer Commission Rate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>InsurerCommission__c</field>
            <value>
                <elementReference>var_InsurerCommission</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Insurer_Commission</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>InsurerCommission__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>InsurancePolicyParticipant</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_InsurerCommission</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
</Flow>

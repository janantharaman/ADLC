            <conditionLogic>(1 OR 2 OR 3 OR 4 ) AND ( ( 5 AND 6 ) OR ( 7 AND 8 ) OR ( 9 AND 10 ) )</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ru_InProgressTask__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>

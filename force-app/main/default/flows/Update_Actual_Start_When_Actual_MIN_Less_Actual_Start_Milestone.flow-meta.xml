<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Actual_Start_Check</name>
        <label>Actual Start Check</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Exit</defaultConnectorLabel>
        <rules>
            <name>Null_or_Start_Greater_Start_MIN</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ActualStart__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ActualStart__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>$Record.ru_ActualStartMIN__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Actual_Start</targetReference>
            </connector>
            <label>Null or Start Greater Start MIN</label>
        </rules>
    </decisions>
    <description>Milestone 레코드의 Actual MIN 값이 변경되고 진행중인 하위 작업이 있는 경우에 Actual Start 보다 Actual MIN 값이 작으면 Actual MIN으로 Actual Start 를 변경</description>
    <environments>Default</environments>
    <interviewLabel>Update Actual Start When Actual MIN Less Actual Start(Milestone) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Actual Start When Actual MIN Less Actual Start(Milestone)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Actual_Start</name>
        <label>Actual Start</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>ActualStart__c</field>
            <value>
                <elementReference>$Record.ru_ActualStartMIN__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Actual_Start_Check</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.ru_ActualStartMIN__c}) &amp;&amp; 
  ( {!$Record.ru_StartTaskActual__c} &gt;= 1
   || {!$Record.ru_StartTaskActual__c} &lt; 1 &amp;&amp;  {!$Record.ru_EndTaskActual__c} &lt; 1 )</filterFormula>
        <object>Milestone__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>1200</triggerOrder>
</Flow>

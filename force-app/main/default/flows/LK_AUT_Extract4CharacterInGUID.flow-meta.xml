<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>GUID 에서 Text 만 추출</description>
        <name>Assign_2_Text</name>
        <label>Extract Text</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_Text</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fm_Text</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>is_InterviewGUID_Length_End</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_4_Digit</name>
        <label>Assign 4 Digit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_4digit</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fm_4digit</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>GUID 에서 Number 만 추출</description>
        <name>Extract_Number</name>
        <label>Extract Number</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_Number</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fm_Number</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>is_InterviewGUID_Length_End</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Loop 제어용 Count Add</description>
        <name>Length_Count_add</name>
        <label>Length Count add</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_Length_Count</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>is_Number</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Length Count 가 Interview GUID 총 길이보다 작은 경우에 반복</description>
        <name>is_InterviewGUID_Length_End</name>
        <label>is InterviewGUID Length End?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_4_Digit</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>end</defaultConnectorLabel>
        <rules>
            <name>Count_less_Then_Length</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_Length_Count</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>fm_GUID_Length</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Length_Count_add</targetReference>
            </connector>
            <label>Count Less Then Length</label>
        </rules>
    </decisions>
    <decisions>
        <description>현재 문자가 Number 인지 체크</description>
        <name>is_Number</name>
        <label>is Number?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_2_Text</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Text</defaultConnectorLabel>
        <rules>
            <name>Number</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fm_Number_Check</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Extract_Number</targetReference>
            </connector>
            <label>Number</label>
        </rules>
    </decisions>
    <description>GUID 에서 4자리 문자 추출
(번호 생성용 - 문자/숫자/문자/숫자)</description>
    <environments>Default</environments>
    <formulas>
        <name>fm_4digit</name>
        <dataType>String</dataType>
        <expression>UPPER(MID({!var_Text},1, 1)) &amp; MID({!var_Number}, 1, 1)  &amp; UPPER(MID({!var_Text},2, 1)) &amp; MID({!var_Number}, 2, 1)</expression>
    </formulas>
    <formulas>
        <description>GUID 의 현재 자리 문자</description>
        <name>fm_Char1</name>
        <dataType>String</dataType>
        <expression>MID({!$Flow.InterviewGuid}, {!var_Length_Count}, 1)</expression>
    </formulas>
    <formulas>
        <name>fm_GUID_Length</name>
        <dataType>Number</dataType>
        <expression>LEN({!$Flow.InterviewGuid})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fm_Number</name>
        <dataType>String</dataType>
        <expression>{!var_Number} &amp; {!fm_Char1}</expression>
    </formulas>
    <formulas>
        <name>fm_Number_Check</name>
        <dataType>Boolean</dataType>
        <expression>ISNUMBER({!fm_Char1})</expression>
    </formulas>
    <formulas>
        <name>fm_Text</name>
        <dataType>String</dataType>
        <expression>{!var_Text} &amp; {!fm_Char1}</expression>
    </formulas>
    <interviewLabel>LK_AUT_Extract4CharacterInGUID {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LK_AUT_Extract4CharacterInGUID</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>is_InterviewGUID_Length_End</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>var_4digit</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>var_Length_Count</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>var_Number</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_Text</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>

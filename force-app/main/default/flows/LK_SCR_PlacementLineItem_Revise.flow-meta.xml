    </customProperties>
    <decisions>
        <name>Data_Check</name>
        <label>Data Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Data_Error_Message_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Else</defaultConnectorLabel>
        <rules>
            <name>Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>v_Count</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_LItem_ID</targetReference>
            </connector>
            <label>Exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>S_LItem_Count_Check</name>
        <label>S LItem Count Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Delete_P_Line_Item</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Delete P Line Item</defaultConnectorLabel>
        <rules>
            <name>Count_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_SLItem_Count</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Message_Screen</targetReference>
            </connector>
            <label>Count &gt;= 1</label>
        </rules>
    </decisions>

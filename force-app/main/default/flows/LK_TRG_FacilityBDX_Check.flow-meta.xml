    <description>Facility BDX 생성/수정 시, 
1. Duplicate 체크
2. Line Item 여부 체크
하나라도 존재 시, 수정 불가</description>
    <environments>Default</environments>
    <formulas>
        <name>fm_BDXNo</name>
        <dataType>String</dataType>
        <expression>{!$Record.Facility_lk__r.ShortName__c} &amp; &quot;-&quot; &amp;
TEXT({!$Record.Facility_lk__r.UY__c}) &amp; &quot;-&quot; &amp;
CASE({!$Record.BDXType__c},
    &quot;Debit Note&quot;, &quot;1&quot;,
    &quot;SOA&quot;, &quot;2&quot;,
    &quot;0&quot;
) &amp; &quot;-&quot; &amp;
{!$Record.BDXPeriod__c} &amp; &quot;-&quot; &amp;
TEXT(BLANKVALUE({!Get_BDX_Records_for_Seq.Seq__c}, 0) + 1)</expression>
    </formulas>
    <formulas>
        <name>fm_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>fm_OnlyRemarksOrSeqChanged</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK({!$Record__Prior.Id})),
    OR(
        ISCHANGED({!$Record.Remarks__c}),
        ISCHANGED({!$Record.Seq__c})
    ),
    NOT(ISCHANGED({!$Record.BDXType__c})),
    NOT(ISCHANGED({!$Record.BDXPeriod__c})),
    NOT(ISCHANGED({!$Record.Account_lk__c})),
    NOT(ISCHANGED({!$Record.IssueFrom__c})),
    NOT(ISCHANGED({!$Record.IssueTo__c})),
    NOT(ISCHANGED({!$Record.Facility_lk__c})),
    NOT(ISCHANGED({!$Record.FacilityParticipant_lk__c}))
)</expression>
    </formulas>
    <formulas>
        <name>fm_Seq</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!Get_BDX_Records_for_Seq.Seq__c}, 0) + 1</expression>
        <scale>2</scale>
    </formulas>

    <description>Standard New 를 통해 Member 를 등록하는 경우, 다른 Type 과 동일 Type 에 동일 Email 을 가진  정보가 있는지 사전 체크, Salesforce User Type 의 경우 사용자 이름과 이메일 정보를 업데이트 한다.</description>
    <environments>Default</environments>
    <formulas>
        <name>fm_UserEmail</name>
        <dataType>String</dataType>
        <expression>IF ( NOT ( ISBLANK ( {!$Record.User__c} ) ), {!$Record.User__r.Email}, {!$Record.Email__c})</expression>
    </formulas>
    <formulas>
        <name>fm_UserName</name>
        <dataType>String</dataType>
        <expression>IF ( NOT ( ISNULL ( {!$Record.User__c} ) ), {!$Record.User__r.LastName} &amp; {!$Record.User__r.FirstName}, &apos;&apos;)</expression>
    </formulas>
    <interviewLabel>Member Standard New Check &amp; Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Member Standard New Check &amp; Update</label>

<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>fm_ImplementationProgress__c</fullName>
    <deprecated>false</deprecated>
    <description>(실적) 완료Task / ( 전체 Task - 취소 Task)</description>
    <formula>IF ( ru_EndTaskActual__c = 0, 0, ru_EndTaskActual__c /  ( ru_TotalTask__c - ru_CanceledTask__c ) )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>End Task(Actual) / Total Task</inlineHelpText>
    <label>Implementation Progress</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>

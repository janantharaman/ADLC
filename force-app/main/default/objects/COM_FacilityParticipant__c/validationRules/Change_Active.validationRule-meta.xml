<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Change_Active</fullName>
    <active>true</active>
    <description>Active는 승인절차를 통해서만 가능하게 제어</description>
    <errorConditionFormula>ISCHANGED(Status__c) &amp;&amp; 
ISPICKVAL(Status__c, &apos;Active&apos;) &amp;&amp; 
NOT(ISPICKVAL(PRIORVALUE(Status__c), &apos;Active&apos;))</errorConditionFormula>
    <errorMessage>Activation is available only through an approval process.</errorMessage>
</ValidationRule>

<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Notify components when Opportunity context data changes</description>
    <isExposed>true</isExposed>
    <lightningMessageFields>
        <description>Opportunity Id</description>
        <fieldName>opportunityId</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>Changed entity (Opportunity, OPP_Layer__c, OPP_Panel__c, OPP_Cobroker__c, ...)</description>
        <fieldName>entity</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>Action (CREATE, UPDATE, DELETE, REFRESH, ...)</description>
        <fieldName>action</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>Caller / reason (MarketLineManage, Allocation, ...)</description>
        <fieldName>reason</fieldName>
    </lightningMessageFields>
    <masterLabel>Opportunity Data Changed</masterLabel>
</LightningMessageChannel>

<apex:page id="COM_RecordListEmailPage" showHeader="false" renderAs="html" contentType="text/html" applyHtmlTag="false"
           controller="COM_RecordListEmail_Ctrl">

    <html lang="ko">
    <body style="margin:0; padding:0; background-color:#f4f6f8;">
    <table width="100%" cellpadding="0" cellspacing="0">
        <tr><td align="center">
                <table width="600" cellpadding="0" cellspacing="0"
                       style="background:#ffffff; font-family:Arial, Helvetica, sans-serif;">

                    <!-- 기존 공통 헤더 컴포넌트 그대로 사용 -->
                    <c:COM_EmailHeader targetId="{!recipientId}" />

                    <tr><td style="padding:30px 30px 10px;">
                            <h2 style="margin:0; font-size:20px; color:#222;">
                                목록 데이터 내보내기
                            </h2>
                        </td></tr>
                    <tr><td style="padding:10px 30px; font-size:14px; color:#555;">
                            안녕하세요 {!recipientName}님,<br/><br/>
                            요청하신 목록 데이터가 첨부파일로 전달되었습니다.<br/>
                            첨부된 Excel 파일을 확인해 주세요.
                        </td></tr>
                    <tr><td style="padding:20px 30px 30px;">
                            <a href="{!recordUrl}"
                               style="display:inline-block; background:#1aa36f; color:#ffffff;
                                text-decoration:none; padding:10px 16px; font-size:13px;
                                border-radius:4px;">
                                Salesforce 레코드 바로가기
                            </a>
                        </td></tr>

                    <!-- 기존 공통 푸터 컴포넌트 그대로 사용 -->
                    <c:COM_EmailFooter />

                </table>
            </td></tr>
    </table>
    </body>
    </html>
</apex:page>
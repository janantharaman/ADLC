<html>
<body style="margin:0; padding:0; background-color:#f4f6f8;">

<table width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td align="center">

      <table width="600" cellpadding="0" cellspacing="0"
             style="background:#ffffff; font-family:Arial, Helvetica, sans-serif;">

        <!-- 헤더 -->
        <tr>
          <td style="background:#1aa36f; padding:20px;">
            <img src="https://www.lkins.co.kr/images/common/logo.png"
                 alt="LK 보험중개" style="height:32px;">
          </td>
        </tr>

        <!-- 제목 -->
        <tr>
          <td style="padding:30px 30px 10px;">
            <h2 style="margin:0; font-size:20px; color:#222;">
              내부 시스템 알림
            </h2>
          </td>
        </tr>

        <!-- 본문 -->
        <tr>
          <td style="padding:10px 30px; font-size:14px; color:#555;">
            안녕하세요 {!Opportunity.OwnerFullName}님,<br><br>
            아래 레코드의 처리 상태가 변경되었습니다.
          </td>
        </tr>

        <!-- 카드 -->
        <tr>
          <td style="padding:0 30px 20px;">
            <table width="100%" cellpadding="10" cellspacing="0"
                   style="background:#f8fafa; border:1px solid #e0e0e0; font-size:13px;">
              <tr>
                <td width="30%" style="font-weight:bold;">대상</td>
                <td>{!Opportunity.Name}</td>
              </tr>
              <tr>
                <td style="font-weight:bold;">단계</td>
                <td>{!Opportunity.StageName}</td>
              </tr>
              <tr>
                <td style="font-weight:bold;">금액</td>
                <td>{!Opportunity.Amount}</td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- 레코드 링크 -->
        <tr>
          <td style="padding:0 30px 30px;">
            <a href="{!Opportunity.Link}"
               style="display:inline-block;
                      background:#1aa36f;
                      color:#ffffff;
                      text-decoration:none;
                      padding:10px 16px;
                      font-size:13px;
                      border-radius:4px;">
              Salesforce 레코드 바로가기
            </a>
          </td>
        </tr>

        <!-- 푸터 -->
        <tr>
          <td style="background:#f0f9f5; padding:15px 30px;
                     font-size:12px; color:#666;">
            본 메일은 LK 보험중개 내부 시스템에서 자동 발송되었습니다.
          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>

</body>
</html>
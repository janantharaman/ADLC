<messaging:emailTemplate subject="[SAMPLE] LK 보험중개 내부 시스템 알림 (단일 레코드)" recipientType="User" relatedToType="Opportunity">

    <messaging:plainTextEmailBody >
[안내: 본 메일은 단일 레코드 정보 전달용 샘플 템플릿입니다.]

안녕하세요 {!recipient.Name}님,
아래 기회 레코드의 상태가 변경되었습니다.

- 기회명: {!relatedTo.Name}
- 현재 단계: {!relatedTo.StageName}

시스템에서 상세 내용을 확인해 주세요.
    </messaging:plainTextEmailBody>

    <messaging:htmlEmailBody >
        <html lang="ko">
            <head>
                <style>
                    /*pretanrd 폰트 적용을 위해 불러오고, 특정 메일사에 의해 폰트를 불러오지 못할 수 있음.*/
                    @import url("https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css");
                    table,tbody,tr,td,h1,h2,h3,h4,h5,h6,p,ul,li,a,button,pre,div{
                        font-family: "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, Roboto, "Helvetica Neue", "Segoe UI", "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", sans-serif;
                    }
                </style>
            </head>
            <body style="padding:0; margin:0;">
                <table border="0" cellpadding="0" cellspacing="0" width="640px" style="max-width:100%; font-family: 'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, system-ui, Roboto, 'Helvetica Neue', 'Segoe UI', 'Apple SD Gothic Neo', 'Noto Sans KR', 'Malgun Gothic', 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', sans-serif;">
                    <tbody>
                        <tr>
                            <td>
                                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%; max-width:100%; padding:24px;">
                                    <tbody>
                                        <tr>
                                            <td>
                                                <!-- 컨텐츠 border 영역 -->
                                                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%; max-width:100%; margin:0 auto; padding:0; border:1px solid #dddddd">
                                                    <tbody>
                                                        <tr>
                                                            <td>
                                                                <!--최상단 border 영역 -->
                                                                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%; max-width:100%; margin:0 auto;">
                                                                    <tbody>
                                                                        <tr>
                                                                            <td>
                                                                                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%; margin:0 auto; max-width:100%; border-top:6px solid #07AA73;">
                                                                                    <tbody>
                                                                                    <tr>
                                                                                        <td></td>
                                                                                    </tr>
                                                                                    </tbody>
                                                                                </table>
                                                                            </td>
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                                <!--최상단 border 영역 종료 -->

                                                                <!--헤더 영역-->
                                                                <c:COM_EmailHeader targetId="{!recipient.Id}" />
                                                                <!--헤더 영역 종료-->

                                                                <!-- 컨텐츠 (본문) 영역 -->
                                                                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%; margin:0 auto; max-width:100%; padding-top:32px; padding-left:40px; padding-right:40px;">
                                                                    <tbody>
                                                                        <tr>
                                                                            <td>
                                                                                <!-- 컨텐츠 타이틀 영역-->
                                                                                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%; max-width:100%; margin:0 auto; padding-bottom:12px;">
                                                                                    <tbody>
                                                                                        <tr>
                                                                                            <td>
                                                                                                <!--타이틀 영역-->
                                                                                                <h3 style="margin:0; padding:0; font-size:24px; font-weight:700; color:#111111; line-height:36px;">기회 상태 변경 알림</h3>
                                                                                                <!--타이틀 영역 종료-->
                                                                                            </td>
                                                                                        </tr>
                                                                                    </tbody>
                                                                                </table>
                                                                                <!-- 컨텐츠 타이틀 영역 종료-->

                                                                                <!-- 컨텐츠 (내용, 표) 영역-->
                                                                                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%; max-width:100%; margin:0 auto;">
                                                                                    <tbody>
                                                                                        <tr>
                                                                                            <td>
                                                                                                <!--내용 영역-->
                                                                                                <p style="padding:0; margin:0; color:#333333; font-weight:400; font-size:14px; line-height:24px; word-break:keep-all;">
                                                                                                    안녕하세요 <strong>{!recipient.Name}</strong>님,<br />
                                                                                                    아래 레코드의 처리 상태가 변경되었습니다.<br />
                                                                                                    해당 내용을 확인해 주시기 바랍니다.
                                                                                                </p>
                                                                                                <!--내용 영역 종료-->
                                                                                            </td>
                                                                                        </tr>
                                                                                    <tr>
                                                                                        <td>
                                                                                            <!--상하 여백 조정 영역-->
                                                                                            <p style="margin:0; padding:0; padding-top:24px;"></p>
                                                                                            <!--상하 여백 조정 영역 종료-->
                                                                                        </td>
                                                                                    </tr>
                                                                                    <tr>
                                                                                        <td>
                                                                                            <!--표 영역-->
                                                                                            <table width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%; max-width:100%; margin:0 auto; border-collapse:collapse;">
                                                                                                <!--표 넓이값 조절 영역-->
                                                                                                <colgroup>
                                                                                                    <col style="width:100px;" />
                                                                                                    <col style="width:auto;" />
                                                                                                </colgroup>
                                                                                                <!--표 넓이값 조절 영역 종료-->
                                                                                                <tbody>
                                                                                                    <tr>
                                                                                                        <th style="padding:8px 12px; background:#F4F4F4; text-align:center; font-size:12px; color:#333; font-weight:700; line-height:18px; border-top:1px solid #EEEEEE; border-bottom:1px solid #EEEEEE;">
                                                                                                            기회명
                                                                                                        </th>
                                                                                                        <td style="padding:8px 12px; background:#FFFFFF; text-align:left; font-size:12px; color:#111; font-weight:400; line-height:18px; border-top:1px solid #EEEEEE; border-bottom:1px solid #EEEEEE;">
                                                                                                            {!relatedTo.Name}
                                                                                                        </td>
                                                                                                    </tr>
                                                                                                    <tr>
                                                                                                        <th style="padding:8px 12px; background:#F4F4F4; text-align:center; font-size:12px; color:#333; font-weight:700; line-height:18px; border-top:1px solid #EEEEEE; border-bottom:1px solid #EEEEEE;">
                                                                                                            현재 단계
                                                                                                        </th>
                                                                                                        <td style="padding:8px 12px; background:#FFFFFF; text-align:left; font-size:12px; color:#111; font-weight:400; line-height:18px; border-top:1px solid #EEEEEE; border-bottom:1px solid #EEEEEE;">
                                                                                                            {!relatedTo.StageName}
                                                                                                        </td>
                                                                                                    </tr>
                                                                                                    <tr>
                                                                                                        <th style="padding:8px 12px; background:#F4F4F4; text-align:center; font-size:12px; color:#333; font-weight:700; line-height:18px; border-top:1px solid #EEEEEE; border-bottom:1px solid #EEEEEE;">
                                                                                                            금액
                                                                                                        </th>
                                                                                                        <td style="padding:8px 12px; background:#FFFFFF; text-align:left; font-size:12px; color:#111; font-weight:400; line-height:18px; border-top:1px solid #EEEEEE; border-bottom:1px solid #EEEEEE;">
                                                                                                            <apex:outputText value="{0, number, ###,###,###,##0}">
                                                                                                                <apex:param value="{!relatedTo.Amount}" />
                                                                                                            </apex:outputText> KRW
                                                                                                        </td>
                                                                                                    </tr>
                                                                                                </tbody>
                                                                                            </table>
                                                                                            <!--표 영역 종료-->
                                                                                        </td>
                                                                                    </tr>
                                                                                    </tbody>
                                                                                </table>
                                                                                <!-- 컨텐츠 (내용, 표) 영역 종료-->

                                                                                <!-- 하단 버튼 영역 -->
                                                                                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="width:100%; max-width:100%; padding:0; margin:0 auto; text-align:center; padding-top:32px;">
                                                                                    <tbody>
                                                                                    <tr>
                                                                                        <td>
                                                                                            <a href="{!LEFT($Api.Partner_Server_URL_550, FIND('/services', $Api.Partner_Server_URL_550))}/{!relatedTo.Id}" target="_blank" style="display:inline-block; font-size:18px; line-height:26px; font-weight:700; color:#fff; padding:11px 70px; background:#1AA36F; border-radius:999px; text-decoration:none;">
                                                                                                Salesforce 레코드 보기
                                                                                            </a>
                                                                                        </td>
                                                                                    </tr>
                                                                                    </tbody>
                                                                                </table>
                                                                                <!-- 하단 버튼 영역 종료 -->
                                                                            </td>
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                                <!-- 컨텐츠 (본문) 영역 종료 -->

                                                                <!-- 푸터 영역-->
                                                                <c:COM_EmailFooter />
                                                                <!-- 푸터 영역 종료-->
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </body>
            <!--
            <body style="margin:0; padding:0; background-color:#f4f6f8; font-family:'Malgun Gothic', sans-serif;">
                <table width="100%" cellpadding="0" cellspacing="0">

                                                        <apex:param value="{!relatedTo.Amount}" />
                                                    </apex:outputText> KRW
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="padding:10px 30px 40px;" align="center">
                                        <a href="{!LEFT($Api.Partner_Server_URL_550, FIND('/services', $Api.Partner_Server_URL_550))}/{!relatedTo.Id}"
                                           style="display:inline-block; background:#1aa36f; color:#ffffff; text-decoration:none; padding:12px 25px; font-size:14px; border-radius:4px; font-weight:bold;">
                                           Salesforce 레코드 보기
                                        </a>
                                    </td>
                                </tr>

                                <c:COM_EmailFooter />

                            </table>
                        </td>
                    </tr>
                </table>

        </body>
            -->
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>
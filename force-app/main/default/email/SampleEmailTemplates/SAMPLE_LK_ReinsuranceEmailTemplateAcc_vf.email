<messaging:emailTemplate subject="[LK] 목록 데이터 내보내기" 
      recipientType="User" 
      relatedToType="Account">

      <!-- 1. 텍스트 버전 -->
      <messaging:plainTextEmailBody >
  안녕하세요 {!recipient.Name}님,

  요청하신 목록 데이터가 첨부파일로 전달되었습니다.

  시스템에 접속하여 확인 부탁드립니다.
      </messaging:plainTextEmailBody>

      <!-- 2. HTML 버전 -->
      <messaging:htmlEmailBody >
          <html lang="ko">
          <body style="margin:0; padding:0; background-color:#f4f6f8;">

          <table width="100%" cellpadding="0" cellspacing="0">
              <tr>
                  <td align="center">

                      <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff; font-family:Arial,
  Helvetica, sans-serif;">

                          <!-- 1. 헤더 -->
                          <c:COM_EmailHeader targetId="{!recipient.Id}" />

                          <!-- 2. 제목 및 인사말 -->
                          <tr>
                              <td style="padding:30px 30px 10px;">
                                  <h2 style="margin:0; font-size:20px; color:#222;">
                                      목록 데이터 내보내기
                                  </h2>
                              </td>
                          </tr>
                          <tr>
                              <td style="padding:10px 30px; font-size:14px; color:#555;">
                                  안녕하세요 {!recipient.Name}님,<br/><br/>
                                  요청하신 목록 데이터가 첨부파일로 전달되었습니다.<br/>
                                  첨부된 Excel 파일을 확인해 주세요.
                              </td>
                          </tr>

                          <!-- 3. 레코드 링크 -->
                          <tr>
                              <td style="padding:20px 30px 30px;">
                                  <a href="{!LEFT($Api.Partner_Server_URL_550, FIND('/services',
  $Api.Partner_Server_URL_550))}/{!relatedTo.Id}"
                                     style="display:inline-block; background:#1aa36f; color:#ffffff;
  text-decoration:none; padding:10px 16px; font-size:13px; border-radius:4px;">
                                      Salesforce 레코드 바로가기
                                  </a>
                              </td>
                          </tr>

                          <!-- 4. 푸터 -->
                          <c:COM_EmailFooter />

                      </table>

                  </td>
              </tr>
          </table>

          </body>
          </html>
      </messaging:htmlEmailBody>
  </messaging:emailTemplate>
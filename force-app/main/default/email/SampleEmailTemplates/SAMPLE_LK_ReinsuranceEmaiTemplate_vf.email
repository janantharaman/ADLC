<messaging:emailTemplate subject="LK 보험중개 내부 시스템 알림" recipientType="User" relatedToType="Opportunity">

    <!-- 1. 텍스트 버전 -->
    <messaging:plainTextEmailBody >
안녕하세요 {!recipient.Name}님,

아래 레코드의 처리 상태가 변경되었습니다.

[대상]: {!relatedTo.Name}
[단계]: {!relatedTo.StageName}
[금액]: {!relatedTo.Amount}

시스템에 접속하여 확인 부탁드립니다.
    </messaging:plainTextEmailBody>

    <!-- 2. HTML 버전 -->
    <messaging:htmlEmailBody >
        <html lang="ko">
        <body style="margin:0; padding:0; background-color:#f4f6f8;">

        <table width="100%" cellpadding="0" cellspacing="0">
            <tr>
                <td align="center">

                    <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff; font-family:Arial, Helvetica, sans-serif;">

                        <!-- 1. 헤더 (기회 소유자 정보 전달) -->
                        <c:COM_EmailHeader targetId="{!recipient.Id}" />

                        <!-- 2. 제목 및 인사말 -->
                        <tr>
                            <td style="padding:30px 30px 10px;">
                                <h2 style="margin:0; font-size:20px; color:#222;">
                                    내부 시스템 알림
                                </h2>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:10px 30px; font-size:14px; color:#555;">
                                안녕하세요 {!recipient.Name}님,<br/><br/>
                                아래 레코드의 처리 상태가 변경되었습니다.
                            </td>
                        </tr>

                        <!-- 3. 본문 카드 -->
                        <c:OPP_OpportunityStatusDigest opp="{!relatedTo}" targetOppId="{!relatedTo.Id}" />

                        <!-- 4. 레코드 링크 -->
                        <tr>
                            <td style="padding:0 30px 30px;">
                                <a href="{!LEFT($Api.Partner_Server_URL_550, FIND('/services', $Api.Partner_Server_URL_550))}/{!relatedTo.Id}"
                                   style="display:inline-block; background:#1aa36f; color:#ffffff; text-decoration:none; padding:10px 16px; font-size:13px; border-radius:4px;">
                                    Salesforce 레코드 바로가기
                                </a>
                            </td>
                        </tr>

                        <!-- 5. 푸터 -->
                        <c:COM_EmailFooter />

                    </table>

                </td>
            </tr>
        </table>

        </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>
<apex:component controller="CLM_DocGenEmailLink_Ctrl" access="global">

    <apex:attribute name="batchProcessId" type="Id" description="DocGenerationBatchProcess Record Id" assignTo="{!bpId}" />

    <apex:outputPanel rendered="{!hasLink}">
        <a href="{!LEFT($Api.Partner_Server_URL_550, FIND('/services', $Api.Partner_Server_URL_550))}/{!referenceObjectId}"
           target="_blank"
           style="display:inline-block; font-size:18px; line-height:26px; font-weight:700; color:#fff; padding:11px 70px; background:#1AA36F; border-radius:999px; text-decoration:none;">
            Salesforce 레코드 보기
        </a>
    </apex:outputPanel>

</apex:component>
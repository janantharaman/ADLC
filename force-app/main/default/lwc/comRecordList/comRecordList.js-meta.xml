<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Com Record List</description>
    <masterLabel>Com Record List</masterLabel>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="pageTitle" type="String" default="" label="Page Title" description="미입력 시 자식 객체 Plural Label 자동 표시" />
            <property name="childObject" type="String" default="" label="자식 객체 API Name" required="true" description="예: FacilityParticipant__c, Opportunity" />
            <property name="parentRecordField" type="String" default="" label="부모 참조 필드 API Name" required="true" description="예: ReinsurerAccount_lk__c, AccountId" />
            <property name="displayFields" type="String" default="Name,CreatedDate" label="표시 필드 (콤마 구분)" description="예: Name,StageName,CreatedDate" />
            <property name="filterCondition" type="String" default="" label="필터 조건 (SOQL WHERE)" description="예: Status__c = 'Active' AND Amount__c > 0" />
            <property name="componentSize" type="String" default="Medium" label="Component Size" description="테이블 높이 (Small: 200px, Medium: 400px, Large: 600px)" datasource="Small,Medium,Large" />
            <property name="showExcelButton" type="Boolean" default="true" label="Save as Excel 버튼 표시" description="false 시 Excel 버튼 숨김" />
            <property name="nameLinkEnabled" type="Boolean" default="false" label="Name 레코드 링크 여부" description="true 시 레코드 링크" />
        </targetConfig>
    </targetConfigs>
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
</LightningComponentBundle>